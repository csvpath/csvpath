~
  id: credentials-config-dump
  macie-origin: job
  macie-job-id: 7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a
  macie-account: 123456789012
  macie-region: us-east-2
  macie-source-arn: arn|aws|macie2|us-east-2|123456789012|classification-job/7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a
  macie-downloaded-at: 20261104T010000Z
  macie-max-findings: 10000
  macie-max-detail: 2
  logic-mode: OR
  print-mode: separate
  validation-mode: collect, match, no-print, no-raise, no-fail, no-stop
~
$[1*][
    macie_mdi(
        "AWS_CREDENTIALS",
        "CREDENTIALS",
        "aws_secret",
        "required",
        "aws_secret_access_key|credentials|secret access key|secret key|set-awscredential",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "GCP_API_KEY",
        "CREDENTIALS",
        "gcp_api_key",
        "required",
        "G_PLACES_KEY|GCP api key|GCP key|google cloud key|google-api-key|google-cloud-apikeys|GOOGLEKEY|X-goog-api-key",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "HTTP_BASIC_AUTH_HEADER",
        "CREDENTIALS",
        "http_basic",
        "none",
        "",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "JSON_WEB_TOKEN",
        "CREDENTIALS",
        "jwt",
        "none",
        "",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "OPENSSH_PRIVATE_KEY",
        "CREDENTIALS",
        "openssh",
        "none",
        "",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "PGP_PRIVATE_KEY",
        "CREDENTIALS",
        "pgp",
        "none",
        "",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "PKCS",
        "CREDENTIALS",
        "pkcs",
        "none",
        "",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "PUTTY_PRIVATE_KEY",
        "CREDENTIALS",
        "putty",
        "none",
        "",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "STRIPE_CREDENTIALS",
        "CREDENTIALS",
        "stripe",
        "none",
        "",
        30,
        "1:HIGH"
    )
    last.nocontrib() -> macie_report()
]
