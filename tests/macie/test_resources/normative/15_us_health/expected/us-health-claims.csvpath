        "PERSONAL_INFORMATION",
        "us_dea",
        "required",
        "dea number|dea registration",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "USA_MEDICARE_BENEFICIARY_IDENTIFIER",
        "PERSONAL_INFORMATION",
        "us_mbi",
        "required",
        "mbi|medicare beneficiary",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "USA_INDIVIDUAL_TAX_IDENTIFICATION_NUMBER",
        "PERSONAL_INFORMATION",
        "us_itin",
        "required",
        "i.t.i.n.|individual taxpayer identification number|itin",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "USA_HEALTH_INSURANCE_CLAIM_NUMBER",
        "PERSONAL_INFORMATION",
        "us_hicn",
        "required",
        "health insurance claim number|hic no|hic no.|hic number|hic#|hicn|hicn#.|hicno#",
        30,
        "1:HIGH"
    )
    macie_mdi(
