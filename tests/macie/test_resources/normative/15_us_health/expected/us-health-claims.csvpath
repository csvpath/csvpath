        "PERSONAL_INFORMATION",
        "us_ndc",
        "required",
        "national drug code|ndc",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "USA_HEALTHCARE_PROCEDURE_CODE",
        "PERSONAL_INFORMATION",
        "us_hcpcs",
        "required",
        "current procedural terminology|hcpcs|healthcare common procedure coding system",
        30,
        "1:HIGH"
    )
    last.nocontrib() -> macie_report()
]
