~
  id: eu-domestic-accounts
  macie-origin: job
  macie-job-id: 5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c
  macie-account: 123456789012
  macie-region: eu-west-1
  macie-source-arn: arn|aws|macie2|eu-west-1|123456789012|classification-job/5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c
  macie-downloaded-at: 20261102T191000Z
  macie-max-findings: 10000
  macie-max-detail: 2
  logic-mode: OR
  print-mode: separate
  validation-mode: collect, match, no-print, no-raise, no-fail, no-stop
~
$[1*][
    macie_mdi(
        "UK_BANK_ACCOUNT_NUMBER",
        "FINANCIAL_INFORMATION",
        "bank:GB",
        "required",
        "account code|account number|accountno#|accountnumber#|bban|customer account id|customer account number|customer bank account id|iban|sepa",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "GERMANY_BANK_ACCOUNT_NUMBER",
        "FINANCIAL_INFORMATION",
        "bank:DE",
        "required",
        "account code|account number|accountno#|accountnumber#|bankleitzahl|bban|customer account id|customer account number|customer bank account id|geheimzahl|iban|kartennummer|kontonummer|kreditkartennummer|sepa",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "FRANCE_BANK_ACCOUNT_NUMBER",
        "FINANCIAL_INFORMATION",
        "bank:FR",
        "required",
        "account code|account number|accountno#|accountnumber#|bban|code bancaire|compte bancaire|customer account id|customer account number|customer bank account id|iban|numéro de compte",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "SPAIN_BANK_ACCOUNT_NUMBER",
        "FINANCIAL_INFORMATION",
        "bank:ES",
        "required",
        "account code|account number|accountno#|accountnumber#|bban|código cuenta|código cuenta bancaria|cuenta cliente id|customer account ID|customer account number|customer bank account id|iban|número cuenta bancaria cliente|número cuenta cliente",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "ITALY_BANK_ACCOUNT_NUMBER",
        "FINANCIAL_INFORMATION",
        "bank:IT",
        "required",
        "account code|account number|accountno#|accountnumber#|bban|codice bancario|conto bancario|customer account id|customer account number|customer bank account id|iban|numero di conto",
        30,
        "1:HIGH"
    )
    last.nocontrib() -> macie_report()
]
