~
$[1*][
    macie_mdi(
        "SPAIN_SOCIAL_SECURITY_NUMBER",
        "PERSONAL_INFORMATION",
        "es_ssn",
        "required",
        "número de la seguridad social|social security no.|social security number|socialsecurityno#|ssn|ssn#",
        30,
        "1:HIGH"
    )
    macie_mdi(
        "USA_SOCIAL_SECURITY_NUMBER",
        "PERSONAL_INFORMATION",
        "us_ssn",
        "required",
        "social security|ss#|ssn",
        30,
        "1:HIGH"
    )
    last.nocontrib() -> macie_report()
]
