  macie-account: 123456789012
  macie-region: us-east-1
  macie-source-arn: arn|aws|macie2|us-east-1|123456789012|classification-job/9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a
  macie-downloaded-at: 20261108T120000Z
