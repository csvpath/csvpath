{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "automobile": {
      "type": "object",
      "properties": {
        "annual": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "year":    { "type": "integer", "minimum": 1900, "maximum": 2100 },
              "imports": { "type": "integer", "minimum": 0 },
              "exports": { "type": "integer", "minimum": 0 }
            },
            "required": ["year", "imports", "exports"],
            "additionalProperties": false
          }
        }
      },
      "required": ["annual"],
      "additionalProperties": false
    }
  },
  "required": ["automobile"],
  "additionalProperties": false
}
